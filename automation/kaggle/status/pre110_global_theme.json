          "text": ""
        },
        {
          "line": 39,
          "text": "static_assert(sizeof(ImmediateVertex) == sizeof(ImDrawVert), \"Vertex types must match\");"
        },
        {
          "line": 40,
          "text": ""
        },
        {
          "line": 41,
          "text": "namespace {"
        },
        {
          "line": 42,
          "text": ""
        },
        {
          "line": 43,
          "text": "// Scale of the menus. On the Switch the window is 1280x720 in handheld mode and 1920x1080 docked (and with"
        },
        {
          "line": 44,
          "text": "// Reverse-NX's Fake Docked), with the medium DPI in both cases: at 1080p the menus had the same pixels and took"
        },
        {
          "line": 45,
          "text": "// up a third less of the screen. Here they are always drawn on a logical canvas of 720 lines, which the immediate"
        },
        {
          "line": 46,
          "text": "// drawer stretches to the window (the coordinate space of ImmediateDrawer::Begin, scissors included): they take up"
        },
        {
          "line": 47,
          "text": "// the same part of the screen in both modes. The window DPI is left alone because the application uses it too"
        },
        {
          "line": 48,
          "text": "// (rex_app.cpp: OnWindowResized and OnDpiScaleChanged)."
        },
        {
          "line": 49,
          "text": "float FisicoALogico(const Window* window) {"
        },
        {
          "line": 50,
          "text": "#if REX_PLATFORM_SWITCH"
        },
        {
          "line": 51,
          "text": "  const uint32_t alto = window->GetActualPhysicalHeight();"
        },
        {
          "line": 52,
          "text": "  if (alto) {"
        },
        {
          "line": 53,
          "text": "    return 720.0f / float(alto);"
        },
        {
          "line": 54,
          "text": "  }"
        },
        {
          "line": 55,
          "text": "#endif"
        },
        {
          "line": 56,
          "text": "  return float(window->GetMediumDpi()) / float(window->GetDpi());"
        },
        {
          "line": 57,
          "text": "}"
        },
        {
          "line": 58,
          "text": ""
        },
